# CinemaReserve environment configuration
#
# The application reads CINEMARESERVE_DB_PATH at startup (see Database.java).
# There is no separate database server to configure -- SQLite stores everything
# in this one file, so this is the only environment variable the app currently uses.
#
# Copy this file to .env and edit if you want the database somewhere other than
# the default ./data/cinemareserve.db, then `export $(cat .env | xargs)` before
# running the scripts in scripts/, or set it directly in your shell/CI config.

CINEMARESERVE_DB_PATH=data/cinemareserve.db

# Seed data (scripts/seed.sh) creates a development-only admin account:
#   username: admin   password: Admin@123
# This is NOT a production secret -- it exists purely so a fresh checkout can be
# demoed immediately, and only its BCrypt hash is ever stored in the database.
# Do not reuse this password for anything real, and do not rely on it in any
# deployment that isn't a local academic demo.
